<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Set Your Password | Admin</title>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Figtree:ital,wght@0,400;0,600;0,700&display=swap" rel="stylesheet">
<style>
  :root{--navy:#2C3D50;--navy-deep:#0E2841;--passion:#D66677;--passion-deep:#C9545F;--gold:#5B9BD5;--muted:#6B7A8D;}
  *{margin:0;padding:0;box-sizing:border-box}
  body{font-family:'Figtree',sans-serif;background:var(--navy-deep);min-height:100vh;display:flex;align-items:center;justify-content:center}
  .card{background:#fff;border-radius:12px;padding:40px 36px;width:100%;max-width:380px;box-shadow:0 20px 60px rgba(0,0,0,.35)}
  h1{font-family:'Anton',sans-serif;text-transform:uppercase;font-size:20px;color:var(--navy);margin-bottom:8px}
  p.sub{color:var(--muted);font-size:14px;margin-bottom:24px}
  label{display:block;font-size:13px;font-weight:600;color:var(--navy);margin-bottom:6px}
  input{width:100%;padding:11px 12px;border:1px solid #DDE3E9;border-radius:6px;font-size:15px;margin-bottom:16px}
  button{width:100%;background:var(--passion);color:#fff;border:none;border-radius:6px;padding:12px;font-weight:700;font-size:15px;cursor:pointer}
  button:hover{background:var(--passion-deep)}
  .err{background:#FDF0F1;color:var(--passion-deep);padding:10px 12px;border-radius:6px;font-size:13.5px;margin-bottom:16px}
</style>
</head>
<body>
  <div class="card">
    <h1>Welcome, <%= displayName %></h1>
    <p class="sub">Set a real password to replace your temporary one.</p>
    <% if (error) { %><div class="err"><%= error %></div><% } %>
    <form method="post" action="/admin/change-password">
      <label for="password">New password</label>
      <input id="password" name="password" type="password" minlength="8" required autofocus>
      <label for="confirm">Confirm password</label>
      <input id="confirm" name="confirm" type="password" minlength="8" required>
      <button type="submit">Set password</button>
    </form>
  </div>
</body>
</html>
