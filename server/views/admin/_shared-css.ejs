<style>
  :root{--navy:#2C3D50;--navy-deep:#0E2841;--passion:#D66677;--passion-deep:#C9545F;--gold:#5B9BD5;--muted:#6B7A8D;--grey:#F1F5F8;--border:#E7E6E6;}
  *{margin:0;padding:0;box-sizing:border-box}
  body{font-family:'Figtree',sans-serif;background:var(--grey);color:var(--navy);min-height:100vh}
  .wrap{max-width:1100px;margin:0 auto;padding:0 24px}
  .adminnav{background:var(--navy-deep);color:#fff;padding:14px 0}
  .adminnav .wrap{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}
  .adminnav .brand{font-family:'Anton',sans-serif;text-transform:uppercase;letter-spacing:.04em;color:#fff;text-decoration:none;font-size:15px}
  .adminnav .links{display:flex;align-items:center;gap:18px;font-size:13.5px}
  .adminnav .links a{color:var(--gold);text-decoration:none}
  .adminnav .links a:hover{text-decoration:underline}
  .adminnav .who{color:#B8D6ED}
  .linkbtn{background:none;border:none;color:var(--passion);font-size:13.5px;cursor:pointer;font-family:inherit;padding:0}
  .linkbtn:hover{text-decoration:underline}
  .page{padding:36px 0}
  h1.title{font-family:'Anton',sans-serif;text-transform:uppercase;font-size:24px;margin-bottom:22px}
  .btn{display:inline-block;background:var(--passion);color:#fff;font-weight:700;font-size:14px;padding:10px 20px;border-radius:6px;text-decoration:none;border:none;cursor:pointer}
  .btn:hover{background:var(--passion-deep)}
  .btn.secondary{background:#fff;color:var(--navy);border:1px solid var(--border)}
  .btn.secondary:hover{background:var(--grey)}
  .btn.danger{background:#fff;color:var(--passion-deep);border:1px solid var(--passion)}
  table{width:100%;border-collapse:collapse;background:#fff;border-radius:10px;overflow:hidden;box-shadow:0 2px 10px rgba(44,61,80,.06)}
  th,td{text-align:left;padding:12px 14px;font-size:14px;border-bottom:1px solid var(--border)}
  th{background:var(--navy);color:#fff;font-size:12px;text-transform:uppercase;letter-spacing:.05em}
  tr:last-child td{border-bottom:none}
  .badge{display:inline-block;padding:3px 9px;border-radius:20px;font-size:11px;font-weight:700;text-transform:uppercase}
  .badge.pub{background:#E4F5F1;color:#1C7A6B}
  .badge.draft{background:#F1F1F1;color:var(--muted)}
  .actions a,.actions button{margin-right:10px;font-size:13px}
  .tabs{display:flex;gap:8px;margin-bottom:20px}
  .tabs a{padding:9px 18px;border-radius:6px;text-decoration:none;font-size:14px;font-weight:600;color:var(--navy);background:#fff;border:1px solid var(--border)}
  .tabs a.active{background:var(--navy);color:#fff;border-color:var(--navy)}
  .form-card{background:#fff;border-radius:10px;padding:28px;box-shadow:0 2px 10px rgba(44,61,80,.06);max-width:820px}
  label{display:block;font-size:13px;font-weight:600;margin-bottom:6px;margin-top:16px}
  label:first-child{margin-top:0}
  input[type=text],input[type=date],input[type=email],select,textarea{width:100%;padding:10px 12px;border:1px solid #DDE3E9;border-radius:6px;font-size:14.5px;font-family:inherit}
  .row2{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  .thumbpreview{max-width:220px;border-radius:8px;margin-top:10px;display:block}
  .hint{font-size:12px;color:var(--muted);margin-top:4px}
  .empty{padding:40px;text-align:center;color:var(--muted)}
</style>
